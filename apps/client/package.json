{
  "name": "@tabu/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --tsconfig tsconfig.app.json --test src/components/*.test.tsx src/lib/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@tabu/shared": "0.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.4",
    "socket.io-client": "^4.8.4",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
